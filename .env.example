# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the filled-in file.
# For a local stack, `npm run db:start` prints the URL and keys to use here.
# ---------------------------------------------------------------------------

# --- Supabase: client-side (safe to ship in the app bundle) ---
# The anon key is protected by Row-Level Security, not by secrecy.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: server-side only. Bypasses RLS. Never expose to a client. ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Edge function secrets (set with `supabase secrets set KEY=value`) ---

# CLIP embedding provider used by the embed-product function.
# Must return a 512-dim vector (ViT-B/32). Replicate or your own endpoint.
CLIP_API_URL=
CLIP_API_KEY=

# LLM used by csv-import (prompt 3.1), photo-to-draft (3.2), tie-breaker (3.3),
# and weekly-report (3.4).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Gemini, for the in-app assistant (apps/web -> /api/ai-query).
#
# This one is a NEXT.JS env var, not a Supabase secret: the assistant runs in
# the web app, so set it wherever the app is deployed (Vercel project settings)
# rather than with `supabase secrets set`. It is server-side only and must NOT
# be given a NEXT_PUBLIC_ prefix — that would ship the key to every browser.
#
# Leave it blank and the assistant behaves exactly as it did before: the
# keyword matcher still answers low stock, average basket and payment mix.
# With a key it understands the question and phrases the answer, but the
# figures still come from your own tables either way.
#
# Free tier: https://aistudio.google.com/apikey
# GEMINI_MODEL is optional — set it if Google retires the default. A 404 from
# the API is logged with that hint and falls back to the keyword matcher.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Transactional email for the weekly owner insight.
RESEND_API_KEY=
REPORT_FROM_EMAIL=reports@example.com

# WhatsApp Business Cloud API for receipts (optional in v1).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Sentry (optional). Leave every line blank and the app behaves exactly as it
# did before monitoring existed: Sentry.init is never called, so nothing is
# captured and no request is ever made. Nothing here is required to run, build
# or deploy.
# ---------------------------------------------------------------------------

# The one switch that turns reporting on. Public by design — a DSN identifies
# a project to send *to*, it grants no read access, and it ships in the client
# bundle of every Sentry-instrumented site. Set it in Vercel for both the
# server and the browser to report.
NEXT_PUBLIC_SENTRY_DSN=

# Labels events in the dashboard. On Vercel this defaults to VERCEL_ENV
# (production / preview / development), so it is only worth setting elsewhere.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# --- Source map upload, build-time only. Needed for readable stack traces. ---
# Without all three, uploads are skipped and the build still succeeds; traces
# arrive minified. SENTRY_AUTH_TOKEN is a real secret — it can write to your
# Sentry org. Set it as an encrypted CI/Vercel variable, never in a commit.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
