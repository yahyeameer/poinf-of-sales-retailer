{
  "name": "ai-pos",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npx turbo run build",
    "dev": "npx turbo run dev",
    "lint": "npx turbo run lint",
    "typecheck": "npx turbo run typecheck",
    "test": "npx turbo run test",
    "db:start": "supabase start --workdir packages/db",
    "db:stop": "supabase stop --workdir packages/db",
    "db:reset": "supabase db reset --workdir packages/db",
    "db:diff": "supabase db diff --workdir packages/db",
    "db:push": "supabase db push --workdir packages/db",
    "db:types": "supabase gen types typescript --workdir packages/db --local > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "supabase": "^2.2.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
